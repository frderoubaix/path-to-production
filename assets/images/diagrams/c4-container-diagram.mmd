C4Container
    title Container Diagram - Plateforme BDA Shotgun

    Person(student, "Etudiant", "Achete ses billets")
    Person(bda, "Membre BDA", "Gere les evenements")

    System_Boundary(platform, "BDA Shotgun Platform") {
        Container(catalog, "Catalog Service [T1]", "Spring Boot 4", "Evenements, plan de salle, disponibilite sieges")
        ContainerDb(db_catalog, "DB Catalog", "PostgreSQL", "")
        ContainerDb(redis, "Cache", "Redis", "Verrous sieges temps reel")

        Container(checkout, "Checkout Service [T2]", "Spring Boot 4", "Commandes, hold siege, paiement")
        ContainerDb(db_orders, "DB Orders", "PostgreSQL", "")

        Container(broker, "Message Broker", "RabbitMQ", "Bus evenements asynchrones")

        Container(ticketing, "Ticketing Service [T3]", "Spring Boot 4", "Generation billets et controle acces")
        ContainerDb(storage, "Storage", "MinIO", "Billets PDF")
    }

    System_Ext(mail, "Mailer", "Mailpit")
    System_Ext(payment_gw, "Payment Gateway", "Mock Stripe")

    Rel(student, catalog, "Consulte evenements / dispo", "REST")
    Rel(student, checkout, "Passe commande", "REST")
    Rel(student, ticketing, "Scan QR acces", "REST")
    Rel(bda, catalog, "Cree evenements et plans", "REST")

    Rel(catalog, db_catalog, "Persiste")
    Rel(catalog, redis, "Verrou siege HELD")
    Rel(catalog, broker, "Publie EventCancelled")

    Rel(checkout, catalog, "COOP T2-T1: verifie et pose verrou siege", "REST sync")
    Rel(checkout, payment_gw, "Paiement", "REST")
    Rel(checkout, db_orders, "Persiste")
    Rel(checkout, broker, "Publie OrderConfirmed")

    Rel(broker, ticketing, "COOP T2-T3: consomme OrderConfirmed", "async")
    Rel(broker, checkout, "COOP T1-T2: consomme EventCancelled", "async")
    Rel(broker, catalog, "COOP T3-T1: consomme TicketCancelled", "async")

    Rel(ticketing, storage, "Stocke PDF")
    Rel(ticketing, mail, "Envoie billet")
    Rel(ticketing, broker, "Publie TicketCancelled")
